# Dominio del tenant, sin https://. Ejemplo: mi-tenant.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Secreto aleatorio de al menos 32 caracteres para cifrar la cookie de sesion.
AUTH0_SESSION_SECRET=

# Credenciales de una aplicacion Machine-to-Machine autorizada para Management API.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
